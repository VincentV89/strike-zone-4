{
  "name": "strikezone-game",
  "version": "0.1.0",
  "private": true,
  "description": "StrikeZone browser game: Vite + TypeScript. kernel-foundation owns src/kernel/ and this scaffold.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "format": "prettier --write .",
    "lint": "eslint --max-warnings 0 . && prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "bench": "vitest bench --run",
    "build": "vite build",
    "check:dist": "node scripts/check-dist.mjs",
    "clean": "node -e \"const fs=require('fs');for(const d of ['dist','coverage'])fs.rmSync(d,{recursive:true,force:true})\"",
    "audit": "npm audit --audit-level=high || true",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && npm run check:dist && npm run clean && npm run audit"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.19.0",
    "@types/three": "~0.187.0",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "^9.39.0",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "~0.21.0",
    "three": "~0.187.0"
  }
}
